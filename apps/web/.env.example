# Copy to apps/web/.env.local (Next.js loads it automatically; the db scripts
# load it through dotenv-cli). `vercel env pull apps/web/.env.local` fills the
# Supabase values after `vercel integration add supabase`.

# --- Postgres (Supabase). Marketplace names are also accepted:
#     POSTGRES_URL (pooled) / POSTGRES_URL_NON_POOLING (direct)
# DATABASE_URL must be the SESSION pooler (port 5432), never the transaction
# pooler (6543): the driver pipelines the concurrent queries a page fires and
# transaction mode cannot route them, so requests hang.
DATABASE_URL=postgres://postgres:solarwave@localhost:54329/solarwave_test
DATABASE_URL_UNPOOLED=postgres://postgres:solarwave@localhost:54329/solarwave_test

# --- Supabase Auth (employee login). Public keys are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used by the seed to create demo employees.
SUPABASE_SERVICE_ROLE_KEY=
SEED_EMPLOYEE_PASSWORD=solarwave-demo-2026

# --- Cloudflare Turnstile. These are Cloudflare's published test keys:
#     the widget always passes and the secret always validates.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Intake rate limiting: salt for hashing client IPs before storage.
INTAKE_IP_SALT=change-me

# --- Portal display timezone for "today" KPIs.
PORTAL_TIMEZONE=America/Sao_Paulo

# --- Google Gemini (scoring worker: extraction, narrative, guardrail judge).
# The Vercel AI Gateway was the original design, but it refuses every request
# until a payment method is on file, free credits included (verified 2026-09-05).
# Google AI Studio issues a free key with no card, so we call Google directly.
# Create one at: https://aistudio.google.com/apikey
# This is the variable name @ai-sdk/google reads by default.
GOOGLE_GENERATIVE_AI_API_KEY=

# Model ids per role. PLAIN ids, with no provider prefix — "gemini-3.8-flash",
# never "google/gemini-3.8-flash". Never hardcode them in source. List what your
# key can reach with:
#   curl -H "x-goog-api-key: $GOOGLE_GENERATIVE_AI_API_KEY" #     "https://generativelanguage.googleapis.com/v1beta/models?pageSize=200"
# MEASURED 2026-09-05 (pnpm eval): gemini-3.5-flash-lite scored 100% on all five
# golden transcripts, 25/25 criteria and 18/18 verbatim evidence quotes.
# gemini-3.8-flash matched it where it answered, but the free tier caps that
# model at 20 requests PER DAY, so a single eval run exhausts it. Flash-lite has
# the headroom and the same accuracy on this task.
SCORING_MODEL_EXTRACTION=gemini-3.5-flash-lite
SCORING_MODEL_NARRATIVE=gemini-3.5-flash-lite
SCORING_MODEL_JUDGE=gemini-3.5-flash-lite

# --- Shared secret for POST /api/internal/score. Any long random string.
SCORING_WORKER_SECRET=change-me
