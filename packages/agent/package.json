{
  "name": "@solarwave/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The conversation agent: the call script assembled from criteria, the tool contract, the conversation loop, the question linter and the persona evaluation suite.",
  "exports": {
    ".": "./src/index.ts",
    "./criteria": "./src/criteria.ts",
    "./personas": "./src/personaCatalogue.ts",
    "./simulate": "./src/simulate.ts",
    "./eval": "./src/eval/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:integration": "dotenv -e ../../apps/web/.env.local -- vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "dotenv -e ../../apps/web/.env.local -- tsx src/eval/run.ts"
  },
  "dependencies": {
    "@solarwave/ai": "workspace:*",
    "@solarwave/core": "workspace:*",
    "@solarwave/db": "workspace:*",
    "@solarwave/scoring": "workspace:*",
    "ai": "^6.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^4",
    "drizzle-orm": "^0.45.2",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.13"
  }
}
